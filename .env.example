# Local development stays open unless this is set to true.
BILLING_REQUIRED=false

# Required together when BILLING_REQUIRED=true. Keep real values in the
# deployment secret manager; never commit them.
APP_BASE_URL=https://relay.example.com
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# Set to a file inside the hosting platform's persistent volume. Leave unset
# for an intentionally ephemeral local demo.
RELAY_DATA_PATH=/data/relay-store.json

# Keep localhost for local use. A container host should set 0.0.0.0.
HOST=127.0.0.1
PORT=8787
